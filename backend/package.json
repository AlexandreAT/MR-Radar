{
    "name": "mr-radar-backend",
    "version": "0.1.0",
    "private": true,
    "description": "Backend local somente leitura que consulta as discussions de Merge Requests no GitLab",
    "engines": {
        "node": ">=16.14.0"
    },
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "start": "ts-node --transpile-only src/index.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "dotenv": "16.4.5",
        "express": "4.19.2"
    },
    "devDependencies": {
        "@types/express": "4.17.21",
        "@types/node": "22.15.21",
        "ts-node": "10.9.2",
        "ts-node-dev": "2.0.0",
        "typescript": "5.4.5"
    }
}
