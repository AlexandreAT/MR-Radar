# Copie este arquivo para "backend/.env" e preencha os valores do provedor que voce usa.
# O .env fica so na sua maquina e nunca vai para o repositorio.
# Os tokens e URLs abaixo sao marcadores ficticios de exemplo: o backend se recusa a rodar com eles.

# Qual provedor o dashboard consulta: "gitlab" (padrao) ou "github".
# Da para deixar as credenciais dos dois preenchidas e so trocar esta linha para alternar.
PROVEDOR=gitlab


# ---- GitLab (obrigatorio quando PROVEDOR=gitlab) ----

# URL da sua instancia do GitLab, sem /api/v4 e sem barra no final.
GITLAB_URL=https://gitlab.example.com

# Personal Access Token com escopo APENAS read_api.
# GitLab > User Settings > Access Tokens
GITLAB_TOKEN=cole_seu_token_aqui


# ---- GitHub (obrigatorio quando PROVEDOR=github) ----

# Personal Access Token com permissao APENAS de leitura.
# Token fine-grained (recomendado): Repository permissions >
#   Contents: Read-only, Pull requests: Read-only, Metadata: Read-only.
# Token classico: escopo "repo" ja basta, mas ele da mais acesso do que o necessario.
# GitHub > Settings > Developer settings > Personal access tokens
GITHUB_TOKEN=cole_seu_token_aqui

# So para GitHub Enterprise Server: o endereco da instancia, sem /api/v3 e sem barra no final.
# Deixe em branco para usar o github.com publico.
# GITHUB_URL=https://github.example.com


# ---- Opcionais: so preencha se quiser mudar o padrao ----

# PORT=3001                  Porta do backend local.
# HOST=127.0.0.1             Endereco em que o backend escuta. Mudar expoe o backend na rede.
# CONTEXT_LINES=3            Linhas de contexto acima e abaixo da linha comentada (0 a 30).
# REQUEST_TIMEOUT_MS=20000   Tempo limite de cada chamada ao provedor.
# MAX_PAGES=20               Limite de paginas ao paginar a API.
# FILE_CACHE_TTL_MS=600000   Tempo de cache do conteudo dos arquivos.
# IGNORED_AUTHORS=           Usernames a ignorar, separados por virgula (ex.: bots de deploy).
